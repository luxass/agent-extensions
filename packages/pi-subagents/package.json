  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-schema": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "pi": {
    "image": "https://raw.githubusercontent.com/luxass/agent-extensions/main/packages/pi-subagents/docs/cover.png",
