{
  "name": "@luxass/pi-subagents",
  "version": "0.0.0",
  "description": "Delegate tasks to named Pi agents and follow their conversations.",
  "keywords": [
    "pi",
    "pi-extension",
    "pi-package",
    "subagents"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/luxass/agent-extensions",
    "directory": "packages/pi-subagents"
  },
  "files": [
