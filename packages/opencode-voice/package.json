    "fmt:check": "oxfmt --check .",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@luxass/agent-voice": "catalog:agent",
    "@opencode/plugin": "catalog:opencode",
    "@opentui/solid": "catalog:opencode",
    "typebox": "catalog:types"
  },
  "engines": {
    "node": ">=24"
  }
