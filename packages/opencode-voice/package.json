{
  "name": "@luxass/opencode-voice",
  "version": "0.1.2",
  "description": "Native microphone capture and transcription for the OpenCode terminal",
  "keywords": [
    "dictation",
    "opencode",
    "opencode-plugin",
    "speech-to-text",
    "transcription",
    "voice"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/luxass/agent-extensions",
    "directory": "packages/opencode-voice"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./tui": "./src/tui.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
