{
  "name": "@luxass/pi-personal",
  "version": "0.1.3",
  "description": "Personal Pi extensions collected in one package, tuned to a single workflow.",
  "keywords": [
    "personal",
    "pi",
    "pi-package"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/luxass/agent-extensions",
    "directory": "packages/pi-personal"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "typecheck": "tsc -p tsconfig.json"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "pi": {
    "image": "https://raw.githubusercontent.com/luxass/agent-extensions/main/packages/pi-personal/docs/cover.png",
    "extensions": [
      "./src/continue-after-compaction.ts",
      "./src/dependency-policy.ts",
      "./src/git-interceptor.ts",
      "./src/package-manager-interceptor.ts",
      "./src/worker-configuration-guard.ts",
      "./src/custom-header.ts",
      "./src/crow/index.ts"
    ]
  }
}
