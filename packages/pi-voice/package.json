{
  "name": "@luxass/pi-voice",
  "version": "0.3.2",
  "description": "Record voice input with /voice, transcribe locally or through an API, and paste it into Pi's composer.",
  "keywords": [
    "dictation",
    "pi",
    "pi-extension",
    "pi-package",
    "speech-to-text",
    "transcription",
    "voice",
    "whisper"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/luxass/agent-extensions",
    "directory": "packages/pi-voice"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "lint": "oxlint --deny-warnings .",
    "lint:fix": "oxlint --fix --deny-warnings .",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@luxass/agent-voice": "catalog:agent"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "engines": {
    "node": ">=24"
  },
  "pi": {
    "image": "https://raw.githubusercontent.com/luxass/agent-extensions/main/packages/pi-voice/docs/cover.png",
    "extensions": [
      "./src/index.ts"
    ]
  }
}
