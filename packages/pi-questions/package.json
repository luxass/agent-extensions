{
  "name": "@luxass/pi-questions",
  "version": "0.1.3",
  "description": "Ask structured questions in Pi with tabs, choices, notes, and Markdown previews.",
  "keywords": [
    "pi",
    "pi-extension",
    "pi-package",
    "questions"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/luxass/agent-extensions",
    "directory": "packages/pi-questions"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@luxass/herdr-agent-shared": "workspace:^"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "pi": {
    "image": "https://raw.githubusercontent.com/luxass/agent-extensions/main/packages/pi-questions/docs/cover.png",
    "extensions": [
      "./src/index.ts"
    ]
  }
}
