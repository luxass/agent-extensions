{
  "name": "agent-extensions",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "covers": "tsc -p scripts/covers/tsconfig.json && node scripts/covers/.generated/generate.js",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "typecheck": "tsc -p tsconfig.json && tsc -p scripts/covers/tsconfig.json --noEmit && pnpm -r --no-bail exec tsc -p tsconfig.json",
    "check": "pnpm lint && pnpm fmt:check && pnpm typecheck",
    "release:version": "changeset version && pnpm install --lockfile-only",
    "release:stage": "pnpm stage publish -r --access public --no-git-checks && changeset git-tag"
  },
  "devDependencies": {
    "@changesets/changelog-github": "catalog:release",
    "@changesets/cli": "catalog:release",
    "@resvg/resvg-js": "catalog:covers",
    "@types/node": "catalog:types",
    "@types/react": "catalog:types",
    "oxfmt": "catalog:lint",
    "oxlint": "catalog:lint",
    "oxlint-tsgolint": "catalog:lint",
    "react": "catalog:covers",
    "satori": "catalog:covers",
    "typebox": "catalog:schema",
    "typescript": "catalog:compiler"
  },
  "packageManager": "pnpm@12.14.0"
}
